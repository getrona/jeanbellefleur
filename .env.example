# Database
DATABASE_URL="postgresql://user:password@localhost:5432/diaspora4bellefleur?schema=public"

# Application
NODE_ENV="development"
SITE_URL="http://localhost:3000"
SUPPORT_EMAIL="support@example.com"

# Feature Flags
ENABLE_DONATIONS="false"

# Payment Provider (Stripe example)
PAYMENT_PROVIDER="stripe"
PAYMENT_PROVIDER_API_KEY="pk_test_..."
PAYMENT_PROVIDER_SECRET="sk_test_..."
PAYMENT_PROVIDER_WEBHOOK_SECRET="whsec_..."

# Security
ENCRYPTION_KEY="generate-a-secure-random-key-here-32-chars-minimum"
SESSION_SECRET="generate-a-secure-random-key-here"

# Compliance
ALLOWED_COUNTRIES="US,CA,FR"
LOG_LEVEL="info"

# News Section
NEWS_ENABLED=false
NEWS_SHOW_SNIPPETS=false
NEWS_GDELT_ENABLED=true
NEWS_GDELT_RATE_LIMIT=0.2
NEWS_RSS_ENABLED=true
NEWS_API_ENABLED=false
NEWS_API_KEY=""
NEWS_API_PROVIDER=""
NEWS_INGEST_SECRET="generate-secure-random-secret-here"
NEWS_INGEST_INTERVAL="0 * * * *"
NEWS_TICKER_INTERVAL_MS=5000
NEWS_TICKER_MAX_ITEMS=8
NEWS_SUGGEST_RATE_LIMIT=5

# Optional: Error Tracking
# SENTRY_DSN=""
